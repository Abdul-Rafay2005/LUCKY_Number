--- !u!114 &311527291
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 311527289}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>GOAL:</b> Work together to hit the target Lucky Number!\n\n\u2022 <b>Turns:</b>
    Active player secretly rolls 3 dice. Choose 1 die to ADD or SUBTRACT from the
    shared score.\n\u2022 <b>Skips:</b> Players have limited voluntary skips that
    don't consume shared moves.\n\u2022 <b>Roles:</b> Most players are Normal; 1-2
    players are secret Imposters.\n\u2022 <b>Imposter Abilities:</b>\n   - <i>Forced
    Block:</i> Secretly prevents a player from rolling on their turn.\n   - <i>Lucky
    Shift:</i> Changes the target Lucky Number by -5 to +5.\n   - <i>Cursed Dice:</i>
    Secretly biases a player's dice toward bad values.\n\n\u2022 <b>Discussion &
    Voting:</b> After each round, discuss and vote to eliminate suspected imposters!\n\u2022
    <b>Win:</b> Normal players win if score reaches Lucky Number OR all imposters
    eliminated. Imposters win if moves run out OR imposters match living normal players."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
